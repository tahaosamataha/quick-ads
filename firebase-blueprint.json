{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A product extracted from a URL by a user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The ID of the user who saved this product."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "The URL of the product."
        },
        "description": {
          "type": "string",
          "description": "The extracted description of the product."
        },
        "images": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri"
          },
          "description": "Array of image URLs extracted for the product."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the product was saved."
        }
      },
      "required": ["uid", "url", "description", "images", "createdAt"]
    },
    "History": {
      "title": "History",
      "description": "A record of generated content (scripts, ads, etc.) saved by a user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The ID of the user who owns this history item."
        },
        "agencyId": {
          "type": "string",
          "description": "The ID of the agency owner if this was generated by a team member."
        },
        "type": {
          "type": "string",
          "enum": ["funnelCopy", "script", "fbAds", "videoScenes", "winnerAngle", "creativePrompts", "textOnVisual"],
          "description": "The type of content generated."
        },
        "content": {
          "type": "object",
          "description": "The generated content (can be a string or an array/object depending on type)."
        },
        "description": {
          "type": "string",
          "description": "The product description used to generate this content."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when the content was saved."
        }
      },
      "required": ["userId", "type", "content", "description", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "A user profile storing settings, role, tokens, etc.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The user ID."
        },
        "email": {
          "type": "string",
          "description": "The user email."
        },
        "name": {
          "type": "string",
          "description": "The user name."
        },
        "role": {
          "type": "string",
          "enum": ["member", "admin", "owner"],
          "description": "The user's role."
        },
        "plan": {
          "type": "string",
          "description": "The user's plan."
        },
        "tokens": {
          "type": "number",
          "description": "Remaining tokens."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "role", "plan", "tokens", "createdAt"]
    },
    "BrandKit": {
      "title": "BrandKit",
      "description": "A saved brand kit containing style and tone rules.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The user ID."
        },
        "name": {
          "type": "string",
          "description": "Name of the brand kit."
        },
        "industry": {
          "type": "string",
          "description": "The industry"
        },
        "colors": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Brand colors."
        },
        "tone": {
          "type": "string",
          "description": "Brand tone."
        },
        "style": {
          "type": "string",
          "description": "Visual style."
        },
        "isActive": {
          "type": "boolean",
          "description": "Is this the active kit?"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "name", "industry", "createdAt"]
    },
    "TokenTransaction": {
      "title": "TokenTransaction",
      "description": "Records changes in token balance.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "type": { "enum": ["usage", "recharge", "bonus"] },
        "amount": { "type": "number" },
        "feature": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "amount", "feature", "createdAt"]
    },
    "AgencyTeam": {
      "title": "AgencyTeam",
      "description": "Information about a team member in an agency.",
      "type": "object",
      "properties": {
        "agencyId": {
          "type": "string",
          "description": "The UID of the agency owner (the one with the Pro/Agency plan)."
        },
        "email": {
          "type": "string",
          "description": "Email of the invited member."
        },
        "role": {
          "type": "string",
          "enum": ["editor", "viewer", "admin"],
          "description": "Member role within the agency."
        },
        "permissions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "List of tool IDs the member is allowed to use (e.g. ['photoshoot', 'script'])."
        },
        "tokenLimit": {
          "type": "number",
          "description": "Maximum tokens this member can consume from the agency pool. 0 means unlimited."
        },
        "tokensUsed": {
          "type": "number",
          "description": "Tokens consumed by this member so far."
        },
        "addedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["agencyId", "email", "role", "permissions", "addedAt"]
    },
    "Integration": {
      "title": "Integration",
      "description": "External platform integration (e.g. Salla).",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "platform": { "type": "string" },
        "accessToken": { "type": "string" },
        "merchantId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "platform", "accessToken", "createdAt"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": {
        "$ref": "#/entities/Product"
      },
      "description": "Collection of products saved by users."
    },
    "/history/{historyId}": {
      "schema": {
        "$ref": "#/entities/History"
      },
      "description": "Collection of generated content history for users."
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/User"
      },
      "description": "Collection of users."
    },
    "/brandKits/{brandKitId}": {
      "schema": {
        "$ref": "#/entities/BrandKit"
      },
      "description": "Collection of brand kits."
    },
    "/tokenTransactions/{transactionId}": {
      "schema": {
        "$ref": "#/entities/TokenTransaction"
      },
      "description": "Collection of token transactions."
    },
    "/agencyTeams/{teamId}": {
      "schema": {
        "$ref": "#/entities/AgencyTeam"
      },
      "description": "Collection of agency team members."
    },
    "/integrations/{integrationId}": {
      "schema": {
        "$ref": "#/entities/Integration"
      },
      "description": "Collection of external platform integrations."
    }
  }
}
